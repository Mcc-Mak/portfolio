{
  "name": "cmmi-opencode-pipeline",
  "version": "1.0.0",
  "description": "CMMI Level 4 OpenCode DevSecOps Pipeline - Windows Final",
  "bin": {
    "reqmind": "tools/reqmind.js"
  },
  "scripts": {
    "pipeline": "powershell -ExecutionPolicy Bypass -File scripts\\opencode-pipeline.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts\\deploy-global.ps1",
    "reqmind": "node tools\\reqmind.js",
    "pipeline:skipdocs": "powershell -ExecutionPolicy Bypass -File scripts\\opencode-pipeline.ps1 -SkipDocs",
    "pipeline:skipsecurity": "powershell -ExecutionPolicy Bypass -File scripts\\opencode-pipeline.ps1 -SkipSecurity",
    "collect-metrics": "node scripts\\collect-metrics.js",
    "dast": "node scripts\\dast-scan.js",
    "spc": "node scripts\\spc-control.js",
    "predict": "node scripts\\predict-readiness.js",
    "lint": "eslint . --ext .js",
    "test": "jest --coverage",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "mathjs": "^12.2.3",
    "regression": "^2.0.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
